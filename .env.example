# Core
APP_NAME=OscarAI
APP_ENV=local
APP_URL=https://oscar-ai.local

# Security & CORS
API_KEY=
CORS_ORIGINS=*

# Persistence
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=oscar_ai
POSTGRES_USER=oscar_ai
POSTGRES_PASSWORD=change-me

REDIS_HOST=redis
REDIS_PORT=6379

QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Embedding Providers (gemini, openai, ollama, hash)
EMBEDDING_PROVIDER=hash
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=text-embedding-004
QDRANT_VECTOR_SIZE=

# Integration
MCP_BASE_URL=http://mcp-gateway:3000
GITHUB_TOKEN=
AZURE_DEVOPS_TOKEN=
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
